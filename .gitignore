# Personal data — never push
/data/bets.db
/data/bets.db-shm
/data/bets.db-wal
/data/cache/
/data/unmatched_log.csv
# Config-tab state — per-deployment operator preference, not source.
/data/runtime_config.json
# Odds-history store — regenerable runtime state, and it grows to GBs. It was
# committed by mistake up to 2026-07-27 (1.2-1.4 GB per commit, 8 blobs over
# GitHub's 100 MB file limit), which silently blocked every push for 11 commits.
# Purged from history with git-filter-repo; never track it again.
/data/ticks.db
/data/ticks.db-shm
/data/ticks.db-wal

# Operational telemetry (regenerated each run)
/dashboard.log*
/output/

# Dev / debug helpers — kept locally but excluded from the published repo
# (these were one-off Playwright capture + Pinnacle probe scripts used
# during scraper development; not part of the running system).
/scripts/

# Claude Code handoff prompts from earlier phases — historical, not load-bearing.
# build_log.md stays under git.
/notes/cc_prompt_*.md

# Python build / cache
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/
.pytest_cache/
pytest-cache-files-*/

# Virtual env (recreated by `python -m venv .venv && pip install -r requirements.txt`)
.venv/
venv/
env/

# Playwright browser install — runs `playwright install chromium` after pip install
.playwright/

# Editor / OS noise
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~
/data/raw/pinnacle_smoke_*.txt
.fuse_hidden*
